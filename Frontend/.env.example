# Base URL of the Pact Pulse backend.
# Copy this file to .env and adjust if the API runs somewhere other than localhost.
#
# Use "localhost", not "127.0.0.1". The refresh cookie is set with SameSite=Lax, and
# browsers treat those two hostnames as different sites: a page served from
# localhost:5173 calling 127.0.0.1:8000 is a cross-site request, so the browser sends
# no cookie and the session never restores. Same host, different port, is same-site.
VITE_API_URL=http://localhost:8000
