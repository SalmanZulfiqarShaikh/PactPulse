# Secrets - never commit. Holds the Gemini and API keys.
.env

# Virtual environment
venv/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Local MongoDB data directory (thousands of WiredTiger files, rewritten on
# every server start). Run Mongo via docker-compose instead of committing it.
data/

# Uploaded contracts and the local vector store (rebuilt from the database)
uploads/
qdrant_data/

# Server and ad-hoc script output
*.log

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
