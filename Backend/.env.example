# Copy this file to .env and fill in the values. .env is git-ignored; never
# commit it.
#
#   Windows:  copy .env.example .env
#   macOS/Linux:  cp .env.example .env

# --- Gemini ----------------------------------------------------------------
# Used for analysis, OCR of scanned PDFs, and document chat.
# For confidential documents use a PAID key: on the free tier Google may use
# what you send to improve its products.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
# The chat agent makes several model calls per question (search, read, answer),
# so it uses the lighter model, which has a much larger free-tier quota.
GEMINI_CHAT_MODEL=gemini-2.5-flash-lite
# 0 + a fixed seed keeps repeated analyses of the same contract consistent.
GEMINI_TEMPERATURE=0
GEMINI_SEED=7

# --- Groq fallback (optional) -------------------------------------------
# When Gemini fails (free-tier quota, outage, missing key), analysis and chat
# retry on Groq. Free key: https://console.groq.com/keys
# Groq cannot read PDFs, so scanned-PDF OCR still needs Gemini. On Groq's free
# tier long contracts are analysed in small pieces, one at a time, so they are
# slower.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Authentication --------------------------------------------------------
# Signing key for access and refresh tokens. REQUIRED: the server refuses to
# start without it, or if it is shorter than 32 characters.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing this invalidates every token that has already been issued, which
# signs every user out. Keep it out of source control, and use a different
# value per environment.
JWT_SECRET=replace-me-with-at-least-32-random-characters

# Token lifetimes. The access token is short lived because it cannot be
# revoked; the refresh token is long lived but only ever sent as an httpOnly
# cookie.
ACCESS_TOKEN_MINUTES=20
REFRESH_TOKEN_DAYS=10

# --- Sign-up email codes (Gmail) -----------------------------------------
# New accounts get a 6-digit code by email. With Gmail:
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an app password: myaccount.google.com/apppasswords
#   3. Put the address and the 16-character app password here (no spaces).
# Leave these empty locally and the code is printed in the backend log instead.
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Pact Pulse

# --- Daily limits per visitor IP -------------------------------------------
# Caps AI usage on a public demo. Counted per IP, so new accounts or a private
# window don't reset them. Days reset at midnight UTC.
DAILY_ANALYSIS_LIMIT=5
DAILY_CHAT_LIMIT=30
DAILY_UPLOAD_LIMIT=10

# Behind a proxy, the header holding the real visitor IP. On Fly.io this is
# Fly-Client-IP (already set in fly.toml). Leave empty locally.
CLIENT_IP_HEADER=

# --- Database --------------------------------------------------------------
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=pact_pulse

# --- HTTP and cookies ------------------------------------------------------
# The frontend origin. Used to decide the Secure flag on the refresh cookie:
# Secure is switched on automatically for anything that is not localhost.
# Set COOKIE_SECURE explicitly to override that.
FRONTEND_ORIGIN=http://localhost:5173

# Comma separated list of allowed browser origins. Must NOT be "*": the refresh
# cookie requires allow_credentials, and browsers reject a wildcard origin in
# that mode. The app refuses to start if it finds one.
CORS_ORIGINS=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
# Login and registration are limited per client IP. Slow down an attacker
# guessing passwords without locking out a real user who mistyped twice.
RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
CHAT_RATE_LIMIT=20/minute

# --- Uploads ---------------------------------------------------------------
MAX_FILE_SIZE=10485760

# --- Document chat (RAG) ---------------------------------------------------
# Embeddings run locally with fastembed (Hugging Face models, no API key). The
# model downloads once on first use. For Urdu or mixed-language documents use
# sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2. Changing the
# model means re-indexing: delete Backend/qdrant_data and restart.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Vectors are stored in an embedded Qdrant database in Backend/qdrant_data.
# To use a Qdrant server or Qdrant Cloud instead, set QDRANT_URL (and
# QDRANT_API_KEY for Cloud).
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=
